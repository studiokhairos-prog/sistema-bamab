Options -Indexes

# Tipos usados pelo aplicativo instalável (PWA).
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js
</IfModule>

# Protege arquivos internos e banco de dados.
<FilesMatch "(^\.|\.(sqlite|sqlite3|db|key|log|ini|env|bak|backup|sql|sh|phar)$)">
  Require all denied
</FilesMatch>

# Impede que arquivos de documentação interna sejam executados ou indexados como conteúdo web.
<FilesMatch "\.(txt|md)$">
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</FilesMatch>

# Cabeçalhos básicos de segurança para hospedagem Apache.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"

  # Permite que o navegador detecte imediatamente novas versões do aplicativo.
  <Files "service-worker.js">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
